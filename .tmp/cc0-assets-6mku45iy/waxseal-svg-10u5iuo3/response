enseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"image/svg+xml"}]},"99620429":{"pageid":99620429,"ns":6,"title":"File:Plakettenmuster f\u00fcr elektrisch betriebene Fahrzeuge gem\u00e4\u00df Anlage 3a (zu \u00a7 9a Absatz 4 FZV).svg","index":10,"imagerepository":"local","imageinfo":[{"size":26969,"width":287,"height":287,"url":"https://upload.wikimedia.org/wikipedia/commons/2/21/Plakettenmuster_f%C3%BCr_elektrisch_betriebene_Fahrzeuge_gem%C3%A4%C3%9F_Anlage_3a_%28zu_%C2%A7_9a_Absatz_4_FZV%29.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Plakettenmuster_f%C3%BCr_elektrisch_betriebene_Fahrzeuge_gem%C3%A4%C3%9F_Anlage_3a_(zu_%C2%A7_9a_Absatz_4_FZV).svg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/99620429","extmetadata":{"DateTime":{"value":"2021-02-06 18:41:29","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Plakettenmuster f\u00fcr elektrisch betriebene Fahrzeuge gem\u00e4\u00df Anlage 3a (zu \u00a7 9a Absatz 4 FZV)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Stickers in Germany|Blue signs in Germany|PD Germany|PD textlogo|Circular objects|Valid SVG created with Inkscape-hand-validated|Valid SVG created with Text Editor|SVG text logos|Electrically-powered land vehicles|Letter E on objects|Black letter E|SVG automobile icons","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Stylized <b>sticker for electrically powered vehicles</b> according to German Anlage 3a (\u00a7 9a Absatz 4 FZV). The <a href=\"https://en.wikipedia.org/wiki/Vehicle_registration_plate\" class=\"extiw\" title=\"w:Vehicle registration plate\">vehicle registration number</a> must be written in the title block by the issuing <a href=\"https://en.wikipedia.org/wiki/Motor_vehicle_registration\" class=\"extiw\" title=\"w:Motor vehicle registration\">registration agency</a> using a <a href=\"https://en.wikipedia.org/wiki/Lightfastness\" class=\"extiw\" title=\"w:Lightfastness\">lightfast</a> <a href=\"https://en.wikipedia.org/wiki/pen\" class=\"extiw\" title=\"w:pen\">pen</a>. The <a href=\"https://en.wikipedia.org/wiki/fee\" class=\"extiw\" title=\"w:fee\">fee</a> to pay is <a href=\"https://en.wikipedia.org/wiki/Euro\" class=\"extiw\" title=\"w:Euro\">\u20ac</a>11 (see <a rel=\"nofollow\" class=\"external text\" href=\"https://www.buzer.de/s1.htm?g=F%C3%BCnfzigste+Verordnung+zur+%C3%84nderung+stra%C3%9Fenverkehrsrechtlicher+Vorschriften&amp;a=3\">Artikel\u00a03 50.\u00a0StVR\u00c4ndV</a>). By validly affixing this <a href=\"https://en.wikipedia.org/wiki/sticker\" class=\"extiw\" title=\"w:sticker\">sticker</a> to the rear of an <a href=\"https://en.wikipedia.org/wiki/electric_vehicle\" class=\"extiw\" title=\"w:electric vehicle\">electric vehicle</a>, which is <a href=\"https://en.wikipedia.org/wiki/Motor_vehicle_registration\" class=\"extiw\" title=\"w:Motor vehicle registration\">registered</a> abroad and that has neither a foreign <a href=\"https://en.wikipedia.org/wiki/Vehicle_registration_plates_of_Germany#Different_formats_and_styles\" class=\"extiw\" title=\"w:Vehicle registration plates of Germany\">E license plate</a> nor a foreign E sticker, since September 26, 2015, the same privileges can be claimed in <a href=\"https://en.wikipedia.org/wiki/Germany\" class=\"extiw\" title=\"w:Germany\">Germany</a> as with an electric vehicle registered in Germany. Practical example: An <a href=\"https://en.wikipedia.org/wiki/electric_car\" class=\"extiw\" title=\"w:electric car\">electric car</a> without an identification as an electric car registered in a country other than Germany requires this sticker in order to be allowed to charge in Germany at a <a href=\"https://en.wikipedia.org/wiki/charging_station\" class=\"extiw\" title=\"w:charging station\">charging station</a> marked with the <a href=\"//commons.wikimedia.org/wiki/File:Zusatzzeichen_1010-66_-_elektrisch_betriebene_Fahrzeuge,_StVO_2015.svg\" title=\"File:Zusatzzeichen 1010-66 - elektrisch betriebene Fahrzeuge, StVO 2015.svg\">German additional sign 1010-66</a>.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2021-02-06","source":"commons-desc-page"},"Credit":{"value":"<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.gesetze-im-internet.de/fzv_2011/anlage_3a.html\">Anlage\u00a03a</a> (zu <a rel=\"nofollow\" class=\"external text\" href=\"https://www.gesetze-im-internet.de/fzv_2011/__9a.html\">\u00a7\u00a09a</a> Absatz\u00a04 <a rel=\"nofollow\" class=\"external text\" href=\"https://www.gesetze-im-internet.de/fzv_2011/index.html\">FZV</a>)</li>\n<li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.bgbl.de/xaver/bgbl/start.xav?startbk=Bundesanzeiger_BGBl&amp;jumpTo=bgbl115s1573.pdf\">BGBl. 2015 I S.\u00a01574</a> (PDF; 285\u00a0kB)\u00a0\u2013 Bundesgesetzblatt Jahrgang 2015 Teil\u00a0I Nr.\u00a036, ausgegeben zu Bonn am 25.\u00a0September 2015, F\u00fcnfzigste Verordnung zur \u00c4nderung stra\u00dfenverkehrsrechtlicher Vorschriften vom 15.\u00a0September 2015</li></ul>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"https://de.wikipedia.org/wiki/Deutschland\" class=\"extiw\" title=\"de:Deutschland\">Bundesrepublik Deutschland</a>, <a href=\"//commons.wikimedia.org/wiki/User:SweetWood\" title=\"User:SweetWood\">SweetWood</a>","source":"commons-desc-page"},"Permission":{"value":"\u00a7\u00a05 Absat